# Maintainer: Sorin Irimies <sorinirimies@gmail.com>
pkgbase=tokenburn
pkgname=('tokenburn' 'tokenburn-gui' 'tokenburn-web' 'tokenburn-tui')
pkgver=0.1.0
pkgrel=1
pkgdesc="Local AI token/cost usage report for pi + Zed — CLI, TUI, GUI and web dashboard"
arch=('x86_64' 'aarch64')
url="https://github.com/sorinirimies/tokenburn"
license=('MIT')
makedepends=('rust' 'cargo' 'cmake' 'pkg-config')
source=("$pkgbase-$pkgver.tar.gz::https://github.com/sorinirimies/tokenburn/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

# Required for the GUI binary
_gui_deps=('libxkbcommon' 'wayland' 'libgl' 'fontconfig')

prepare() {
    cd "$pkgbase-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgbase-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --package tokenburn
    cargo build --frozen --release --package tokenburn-gui
    cargo build --frozen --release --package tokenburn-web
    cargo build --frozen --release --package tokenburn-tui
}

package_tokenburn() {
    pkgdesc="TokenBurn — local AI token/cost usage CLI (clap)"
    depends=('gcc-libs')
    cd "$pkgbase-$pkgver"
    install -Dm755 "target/release/tokenburn" "$pkgdir/usr/bin/tokenburn"
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/tokenburn/LICENSE"
    install -Dm644 "README.md" "$pkgdir/usr/share/doc/tokenburn/README.md"
}

package_tokenburn-gui() {
    pkgdesc="TokenBurn — desktop GUI AI token usage report written in Rust (Iced)"
    depends=("${_gui_deps[@]}")
    cd "$pkgbase-$pkgver"
    install -Dm755 "target/release/tokenburn-gui" "$pkgdir/usr/bin/tokenburn-gui"
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/tokenburn-gui/LICENSE"
    install -Dm644 "README.md" "$pkgdir/usr/share/doc/tokenburn-gui/README.md"
}

package_tokenburn-web() {
    pkgdesc="TokenBurn web — local AI token usage dashboard written in Rust (Topcoat)"
    depends=('gcc-libs')
    cd "$pkgbase-$pkgver"
    install -Dm755 "target/release/tokenburn-web" "$pkgdir/usr/bin/tokenburn-web"
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/tokenburn-web/LICENSE"
    install -Dm644 "README.md" "$pkgdir/usr/share/doc/tokenburn-web/README.md"
}

package_tokenburn-tui() {
    pkgdesc="TokenBurn TUI — terminal AI token usage report written in Rust (Ratatui)"
    depends=('gcc-libs')
    cd "$pkgbase-$pkgver"
    install -Dm755 "target/release/tokenburn-tui" "$pkgdir/usr/bin/tokenburn-tui"
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/tokenburn-tui/LICENSE"
    install -Dm644 "README.md" "$pkgdir/usr/share/doc/tokenburn-tui/README.md"
}
